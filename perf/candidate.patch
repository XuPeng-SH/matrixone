+func TestODKUColdBankCopyFailureDoesNotPublish(t *testing.T) {
+	mp := mpool.MustNewZero()
+	proc := testutil.NewProcessWithMPool(t, "", mp)
+	rowTypes := []types.Type{types.T_int64.ToType(), types.T_varchar.ToType()}
+	arg := &DedupJoin{LeftTypes: rowTypes}
+	registry, err := mpool.NewAllocationAccountRegistry(1, 64)
+	require.NoError(t, err)
+	account, err := registry.Open(8192)
+	require.NoError(t, err)
+	require.NoError(t, arg.SetAllocationAccount(account))
+	input := batch.NewWithSize(len(rowTypes))
+	t.Cleanup(func() {
+		arg.Reset(proc, false, nil)
+		arg.Free(proc, false, nil)
+		input.Clean(mp)
+		proc.Free()
+		require.Zero(t, account.Snapshot().Used)
+		require.Zero(t, mp.CurrNB())
+	})
+	for i, typ := range rowTypes {
+		input.Vecs[i] = vector.NewVec(typ)
+	}
+	require.NoError(t, vector.AppendFixed(input.Vecs[0], int64(7), false, mp))
+	large := strings.Repeat("wide", 8192)
+	require.NoError(t, vector.AppendBytes(input.Vecs[1], []byte(large), false, mp))
+	input.SetRowCount(1)
+	start := func() *odkuReplay {
+		o := &arg.ctr.odku
+		o.image = batch.NewWithSize(len(rowTypes))
+		copy(o.image.Vecs, input.Vecs)
+		o.image.SetRowCount(1)
+		o.before = batch.NewWithSize(len(rowTypes))
+		o.before.SetRowCount(1)
+		o.mutable = []int32{0, 1}
+		return o
+	}
+	o := start()
+	err = o.update(arg, false, proc)
+	require.ErrorIs(t, err, mpool.ErrAllocationAccountCapacity)
+	require.Equal(t, 1, o.banks[0][0].Length(), "the first column was copied before admission failed")
+	require.Same(t, input.Vecs[0], o.image.Vecs[0])
+	require.Same(t, input.Vecs[1], o.image.Vecs[1])
+	require.Equal(t, large, input.Vecs[1].GetStringAt(0))
+	arg.Reset(proc, true, err)
+	require.Zero(t, account.Snapshot().Used)
+
+	// Reuse the same owner after cleanup with a value that fits the budget.
+	input.Vecs[1].CleanOnlyData()
+	require.NoError(t, vector.AppendBytes(input.Vecs[1], []byte("small"), false, mp))
+	o = start()
+	require.NoError(t, o.update(arg, false, proc))
+	require.Equal(t, "small", o.image.Vecs[1].GetStringAt(0))
+}
