+// Legacy plans have no per-plan evaluation-mode marker. The existing v12
+// rollout gate is promoted only after old plans are drained and all CNs are
+// upgraded; before then retain their original staged evaluation.
+func sequentialCompatibilityODKU(proc *process.Process) (bool, error) {
+	if proc == nil {
+		return false, moerr.NewNotSupported(context.Background(), "compatibility ODKU requires a valid protocol version")
+	}
+	rt := moruntime.ServiceRuntime(proc.GetService())
+	if rt == nil {
+		return false, moerr.NewNotSupported(proc.Ctx, "compatibility ODKU requires a valid protocol version")
+	}
+	v, ok := rt.GetGlobalVariables(moruntime.MOProtocolVersion)
+	version, valid := v.(int64)
+	if !ok || !valid {
+		return false, moerr.NewNotSupported(proc.Ctx, "compatibility ODKU requires a valid protocol version")
+	}
+	return version >= defines.MORPCVersion12, nil
+}
+
+func (ctr *container) evalCompatibilityODKU(ap *DedupJoin, proc *process.Process, sequential bool) error {
+	if sequential {
+		for i, exec := range ctr.exprExecs {
+			v, err := exec.Eval(proc, []*batch.Batch{ctr.joinBat1, ctr.joinBat2}, nil)
+			if err != nil {
+				return err
+			}
+			ctr.joinBat1.Vecs[ap.UpdateColIdxList[i]] = v
+		}
+		return nil
+	}
+	vecs := make([]*vector.Vector, len(ctr.exprExecs))
+	for i, exec := range ctr.exprExecs {
+		v, err := exec.Eval(proc, []*batch.Batch{ctr.joinBat1, ctr.joinBat2}, nil)
+		if err != nil {
+			return err
+		}
+		vecs[i] = v
+	}
+	for i, pos := range ap.UpdateColIdxList {
+		ctr.joinBat1.Vecs[pos] = vecs[i]
+	}
+	return nil
+}
+
+// The wrapper has saved the batch-owned vectors before any assignment. Use
+// their physical types for scratch, including when finalize uses the build
+// side's layout instead of the probe side's layout.
+func (ctr *container) stabilizeCompatibilityODKU(ap *DedupJoin, proc *process.Process, scratch *odkuReplay, rowTypes *[]types.Type) error {
+	if scratch.image == nil {
+		scratch.image = ctr.joinBat1
+		seen := make([]bool, len(ctr.joinBat1.Vecs))
+		*rowTypes = make([]types.Type, len(ctr.joinBat1.Vecs))
+		for i, pos := range ap.UpdateColIdxList {
+			if !seen[pos] {
+				seen[pos] = true
+				scratch.mutable = append(scratch.mutable, pos)
+				(*rowTypes)[pos] = *ctr.savedVecs[i].GetType()
+			}
+		}
+	}
+	return scratch.stabilize(ap, *rowTypes, proc)
+}
+
+// Scratch must outlive the callback, but not its group. The restore wrapper
+// returns before this defer frees any vectors borrowed by joinBat1.
+func (ctr *container) withCompatibilityODKUScratch(ap *DedupJoin, proc *process.Process, fn func(*odkuReplay, *[]types.Type) error) error {
+	var scratch odkuReplay
+	var rowTypes []types.Type
+	defer scratch.freeBanks(proc)
+	return ctr.withRestoredJoinBat1Vectors(ap.UpdateColIdxList, func() error {
+		return fn(&scratch, &rowTypes)
+	})
+}
