+func TestCompatibilityODKURolloutGate(t *testing.T) {
+	proc := testutil.NewProcessWithMPool(t, "", mpool.MustNewZero())
+	t.Cleanup(proc.Free)
+	rt := moruntime.ServiceRuntime(proc.GetService())
+	old, existed := rt.GetGlobalVariables(moruntime.MOProtocolVersion)
+	t.Cleanup(func() {
+		if existed {
+			rt.SetGlobalVariables(moruntime.MOProtocolVersion, old)
+		} else if current, ok := rt.GetGlobalVariables(moruntime.MOProtocolVersion); ok {
+			rt.CompareAndDeleteGlobalVariables(moruntime.MOProtocolVersion, current)
+		}
+	})
+	rt.SetGlobalVariables(moruntime.MOProtocolVersion, int64(defines.MORPCVersion11))
+	sequential, err := sequentialCompatibilityODKU(proc)
+	require.NoError(t, err)
+	require.False(t, sequential)
+	rt.SetGlobalVariables(moruntime.MOProtocolVersion, int64(defines.MORPCVersion12))
+	sequential, err = sequentialCompatibilityODKU(proc)
+	require.NoError(t, err)
+	require.True(t, sequential)
+	rt.SetGlobalVariables(moruntime.MOProtocolVersion, "invalid")
+	_, err = sequentialCompatibilityODKU(proc)
+	require.True(t, moerr.IsMoErrCode(err, moerr.ErrNotSupported))
+	require.True(t, rt.CompareAndDeleteGlobalVariables(moruntime.MOProtocolVersion, "invalid"))
+	_, err = sequentialCompatibilityODKU(proc)
+	require.True(t, moerr.IsMoErrCode(err, moerr.ErrNotSupported))
+	_, err = sequentialCompatibilityODKU(nil)
+	require.True(t, moerr.IsMoErrCode(err, moerr.ErrNotSupported))
+}
