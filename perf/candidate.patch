+func TestCompatibilityODKUScratchRestoresAfterFailure(t *testing.T) {
+	mp := mpool.MustNewZero()
+	proc := testutil.NewProcessWithMPool(t, "", mp)
+	arg := &DedupJoin{UpdateColIdxList: []int32{0, 1, 1}}
+	registry, err := mpool.NewAllocationAccountRegistry(1, 64)
+	require.NoError(t, err)
+	account, err := registry.Open(8192)
+	require.NoError(t, err)
+	require.NoError(t, arg.SetAllocationAccount(account))
+	arg.ctr.joinBat1 = batch.NewWithSize(2)
+	arg.ctr.joinBat1.Vecs[0] = vector.NewVec(types.T_int64.ToType())
+	arg.ctr.joinBat1.Vecs[1] = vector.NewVec(types.T_varchar.ToType())
+	borrowed := vector.NewVec(types.T_varchar.ToType())
+	t.Cleanup(func() {
+		arg.Reset(proc, false, nil)
+		arg.Free(proc, false, nil)
+		borrowed.Free(mp)
+		proc.Free()
+		require.Zero(t, account.Snapshot().Used)
+		require.Zero(t, mp.CurrNB())
+	})
+	require.NoError(t, vector.AppendFixed(arg.ctr.joinBat1.Vecs[0], int64(7), false, mp))
+	require.NoError(t, vector.AppendBytes(arg.ctr.joinBat1.Vecs[1], []byte("original"), false, mp))
+	arg.ctr.joinBat1.SetRowCount(1)
+	original := append([]*vector.Vector(nil), arg.ctr.joinBat1.Vecs...)
+	require.NoError(t, vector.AppendBytes(borrowed, bytes.Repeat([]byte("x"), 32768), false, mp))
+
+	err = arg.ctr.withCompatibilityODKUScratch(arg, proc, func(scratch *odkuReplay, rowTypes *[]types.Type) error {
+		arg.ctr.joinBat1.Vecs[1] = borrowed
+		return arg.ctr.stabilizeCompatibilityODKU(arg, proc, scratch, rowTypes)
+	})
+	require.ErrorIs(t, err, mpool.ErrAllocationAccountCapacity)
+	require.Same(t, original[0], arg.ctr.joinBat1.Vecs[0])
+	require.Same(t, original[1], arg.ctr.joinBat1.Vecs[1])
+	require.Equal(t, "original", arg.ctr.joinBat1.Vecs[1].GetStringAt(0))
+	require.Len(t, borrowed.GetBytesAt(0), 32768)
+	require.Zero(t, account.Snapshot().Used)
+
+	borrowed.CleanOnlyData()
+	require.NoError(t, vector.AppendBytes(borrowed, []byte("small"), false, mp))
+	wantErr := errors.New("injected expression error")
+	err = arg.ctr.withCompatibilityODKUScratch(arg, proc, func(scratch *odkuReplay, rowTypes *[]types.Type) error {
+		arg.ctr.joinBat1.Vecs[1] = borrowed
+		if err := arg.ctr.stabilizeCompatibilityODKU(arg, proc, scratch, rowTypes); err != nil {
+			return err
+		}
+		return wantErr
+	})
+	require.ErrorIs(t, err, wantErr)
+	require.Same(t, original[1], arg.ctr.joinBat1.Vecs[1])
+	require.Zero(t, account.Snapshot().Used)
+}
