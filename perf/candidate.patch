+				require.Equal(t, 1, result[0].NodeInfo.Mcpu)
+				require.Equal(t, inputs, result[0].PreScopes)
+				require.Len(t, result[0].Proc.Reg.MergeReceivers, len(inputs))
+				for i, s := range inputs {
