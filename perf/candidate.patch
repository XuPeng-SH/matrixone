+func TestODKUColdBankCrossColumnAliases(t *testing.T) {
+	for _, width := range []int{128, 129} {
+		t.Run(fmt.Sprintf("width=%d", width), func(t *testing.T) {
+			mp := mpool.MustNewZero()
+			proc := testutil.NewProcessWithMPool(t, "", mp)
+			typ := types.T_int64.ToType()
+			rowTypes := make([]types.Type, width)
+			for i := range rowTypes {
+				rowTypes[i] = typ
+			}
+			input := batch.NewWithSize(len(rowTypes))
+			arg := &DedupJoin{LeftTypes: rowTypes}
+			account := installTestAllocation(t, arg)
+			t.Cleanup(func() {
+				arg.Reset(proc, false, nil)
+				arg.Free(proc, false, nil)
+				input.Clean(mp)
+				proc.Free()
+				require.Zero(t, account.Snapshot().Used)
+				require.Zero(t, mp.CurrNB())
+			})
+			for i := range rowTypes {
+				input.Vecs[i] = vector.NewVec(typ)
+				require.NoError(t, vector.AppendFixed(input.Vecs[i], int64(1000+i), false, mp))
+			}
+			input.SetRowCount(1)
+			o := &arg.ctr.odku
+			o.image = batch.NewWithSize(len(rowTypes))
+			copy(o.image.Vecs, input.Vecs)
+			o.image.SetRowCount(1)
+			o.before = batch.NewWithSize(len(rowTypes))
+			o.before.SetRowCount(1)
+			// Bank slot 0 belongs to column 1, but its value is borrowed by column 0.
+			// Five mutable columns exercise both sides of the bounded-scan cutoff.
+			o.mutable = []int32{1, 0, 2, 3, 4}
+			for b := range o.banks {
+				o.banks[b] = make([]*vector.Vector, len(o.mutable))
+				for i := range o.banks[b] {
+					var err error
+					o.banks[b][i], err = arg.newResultVector(typ)
+					require.NoError(t, err)
+					require.NoError(t, vector.AppendFixed(o.banks[b][i], int64(2000+b*100+i), false, mp))
+				}
+			}
+			o.image.Vecs[0] = o.banks[0][0]
+			require.NoError(t, o.update(arg, false, proc))
+			require.Equal(t, int64(2000), vector.GetFixedAtNoTypeCheck[int64](o.image.Vecs[0], 0))
+			require.Equal(t, int64(1001), vector.GetFixedAtNoTypeCheck[int64](o.image.Vecs[1], 0))
+			require.Equal(t, int64(2000), vector.GetFixedAtNoTypeCheck[int64](o.banks[0][0], 0))
+			require.Same(t, o.banks[1][1], o.image.Vecs[0])
+
+			// The live set must be recomputed: bank 1 is now live and bank 0 is cold.
+			require.NoError(t, o.update(arg, false, proc))
+			require.Same(t, o.banks[0][1], o.image.Vecs[0])
+			require.Equal(t, int64(2000), vector.GetFixedAtNoTypeCheck[int64](o.image.Vecs[0], 0))
+
+			// A live vector from each bank, even in nonmutable columns, leaves no
+			// safe destination and must not change the image.
+			o.image.Vecs[10], o.image.Vecs[11] = o.banks[0][0], o.banks[1][0]
+			before := append([]*vector.Vector(nil), o.image.Vecs...)
+			err := o.update(arg, false, proc)
+			require.True(t, moerr.IsMoErrCode(err, moerr.ErrInternal), "%v", err)
+			for i := range before {
+				require.Same(t, before[i], o.image.Vecs[i])
+			}
+		})
+	}
+}
